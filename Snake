        <!-- Center: Game Board & Overlays -->
        <div class="game-canvas-wrapper glass-panel rounded-2xl p-2 sm:p-3 relative border border-slate-800 shadow-2xl flex items-center justify-center">
            
            <canvas id="game-canvas" width="600" height="600"></canvas>

            <!-- START SCREEN OVERLAY -->
