            <!-- GAME OVER OVERLAY -->
            <div id="gameover-overlay" class="hidden absolute inset-0 z-20 flex flex-col items-center justify-center p-6 bg-slate-950/90 rounded-2xl backdrop-blur-lg text-center">
                <div class="w-16 h-16 mb-3 rounded-full bg-red-500/20 border border-red-500/50 flex items-center justify-center text-red-500 text-2xl shadow-lg shadow-red-500/20">
                    <i class="fa-solid fa-skull"></i>
                </div>
                <h2 class="text-3xl sm:text-4xl font-black font-orbitron text-red-500 mb-1 neon-text-magenta">SYSTEM CRASH</h2>
