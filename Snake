                    <div class="flex justify-between items-center text-sm">
                        <span class="text-slate-400">Final Score:</span>
                        <span id="final-score" class="font-orbitron font-extrabold text-teal-300 text-xl">0</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-slate-400">Length Reached:</span>
                        <span id="final-length" class="font-orbitron font-bold text-slate-200">0</span>
