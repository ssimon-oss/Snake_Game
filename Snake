                <h2 class="text-3xl sm:text-4xl font-black font-orbitron text-white mb-2">READY TO SLITHER?</h2>
                <p class="text-sm text-slate-300 max-w-xs mb-6 font-medium">Collect glowing energy orbs, grab rare power-ups, and avoid hitting the walls or your own tail!</p>
                
                <!-- Game Mode Selector -->
