<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Neon Cyber Snake</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800;900&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-color: #0b0f19;
            --grid-color: rgba(255, 255, 255, 0.04);
            --snake-head: #00ffcc;
            --snake-body: #00b386;
            --food-color: #ff0055;
            --accent-glow: rgba(0, 255, 204, 0.4);
            --font-game: 'Orbitron', sans-serif;
            --font-ui: 'Rajdhani', sans-serif;
        }

        body {
            font-family: var(--font-ui);
            background-color: var(--bg-color);
            color: #ffffff;
            overflow-x: hidden;
            user-select: none;
            -webkit-user-select: none;
        }

        .font-orbitron { font-family: var(--font-game); }
        
        /* Glassmorphism panel styling */
        .glass-panel {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

        .glass-btn {
            background: rgba(255, 255, 255, 0.07);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-btn:hover {
            background: rgba(255, 255, 255, 0.18);
            border-color: rgba(0, 255, 204, 0.6);
            box-shadow: 0 0 15px rgba(0, 255, 204, 0.4);
            transform: translateY(-2px);
        }

        .glass-btn:active {
            transform: translateY(1px);
        }

        /* Dynamic glow effects */
        .neon-text-cyan {
            text-shadow: 0 0 8px rgba(0, 255, 204, 0.7), 0 0 20px rgba(0, 255, 204, 0.4);
        }

        .neon-text-magenta {
            text-shadow: 0 0 8px rgba(255, 0, 128, 0.7), 0 0 20px rgba(255, 0, 128, 0.4);
        }

        .neon-border {
            box-shadow: 0 0 15px var(--accent-glow), inset 0 0 15px var(--accent-glow);
        }

        /* Pulse Animations */
        @keyframes pulse-glow {
            0%, 100% { opacity: 0.8; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.03); }
        }

        .animate-pulse-glow {
            animation: pulse-glow 2s infinite ease-in-out;
        }

        /* Canvas Container Aspect Ratio */
        .game-canvas-wrapper {
            position: relative;
            width: 100%;
            max-width: 600px;
            aspect-ratio: 1 / 1;
        }

        canvas {
            display: block;
            width: 100%;
            height: 100%;
            border-radius: 16px;
        }

        /* D-Pad controls for mobile */
        .dpad-btn {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.15);
            touch-action: manipulation;
        }

        .dpad-btn:active {
            background: rgba(0, 255, 204, 0.3);
            border-color: #00ffcc;
        }

        /* Custom Scrollbars */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(0,0,0,0.2);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(0, 255, 204, 0.3);
            border-radius: 3px;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-between p-3 sm:p-6 bg-slate-950 text-slate-100">

    <!-- Top Header / Bar -->
    <header class="w-full max-w-4xl flex justify-between items-center mb-3 sm:mb-6 glass-panel px-4 py-3 rounded-2xl">
        <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-teal-500 to-emerald-300 flex items-center justify-center text-slate-950 font-bold text-xl shadow-lg shadow-teal-500/30">
                <i class="fa-solid font-bold fa-staff-snake text-xl"></i>
            </div>
            <div>
                <h1 class="text-xl sm:text-2xl font-black font-orbitron tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-teal-300 via-emerald-400 to-cyan-400">
                    CYBER<span class="text-pink-500">SNAKE</span>
                </h1>
                <p class="text-xs text-slate-400 font-semibold tracking-widest uppercase">Arcade Edition v2.5</p>
            </div>
        </div>

        <!-- Controls / Actions -->
        <div class="flex items-center space-x-2">
            <button id="audio-toggle-btn" class="glass-btn p-2.5 rounded-xl text-teal-300 hover:text-white" title="Toggle Sound">
                <i id="audio-icon" class="fa-solid fa-volume-high text-lg"></i>
            </button>
            <button id="theme-btn" class="glass-btn p-2.5 rounded-xl text-teal-300 hover:text-white" title="Change Theme">
